#!/usr/bin/env bash
set -euo pipefail

if ! command -v sbx >/dev/null 2>&1; then
	echo "No sbx CLI found in PATH." >&2
	echo "Install it with: brew install docker/tap/sbx" >&2
	exit 1
fi

SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
REPO="$(cd "$(dirname "${SCRIPT}")/.." && pwd)"
KIT="${REPO}/sbxclaude"
AGENT="sbxclaude" # == spec.yaml name:
SANDBOX="$(basename "${PWD}" | tr -c 'a-zA-Z0-9-' '-' | sed 's/-*$//')"
if [[ -z "${SANDBOX}" ]]; then
	echo "Could not derive a sandbox name from the current directory (${PWD})" >&2
	exit 1
fi

case "${1:-}" in
-v | --validate) exec sbx kit validate "${KIT}" ;;
-i | --inspect) exec sbx inspect "${SANDBOX}" ;;
-l | --log) exec sbx policy log "${SANDBOX}" ;;
--check)
	shift
	exec sbx policy check network "$@"
	;;
-e | --exec)
	shift
	exec sbx exec "${SANDBOX}" -- "$@"
	;;
--reload) exec sbx kit add "${SANDBOX}" "${KIT}" ;; # recreates, keeps state
--rebuild)
	sbx rm --force "${SANDBOX}" 2>/dev/null || true
	shift
	;;
--create)
	sbx kit validate "${KIT}" >/dev/null
	exec sbx create --name "${SANDBOX}" --kit "${KIT}" "${AGENT}" . # build only, don't attach
	;;
-h | --help)
	echo "sbxclaude [--rebuild|--reload|--create|--validate|--inspect|--log|--check HOST|--exec CMD...]"
	exit 0
	;;
*) ;; # no flag, or a prompt for the agent — fall through and pass "$@" below
esac

if sbx inspect "${SANDBOX}" >/dev/null 2>&1; then
	exec sbx run --name "${SANDBOX}" -- "$@" # re-attach
fi

sbx kit validate "${KIT}" >/dev/null
exec sbx run --name "${SANDBOX}" --kit "${KIT}" "${AGENT}" -- "$@" # first create
